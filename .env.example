# Docket environment variables
#
# Copy this file to .env and fill in what you need; a blank value means unset.
# The backend loads .env on startup (dotenv), so this works for `npm run dev` and `npm run start`.
# With Docker, set these under `environment:` in compose.yaml instead.
#
# Command-line arguments (for example --port) take priority over these.

# ---- Paths -------------------------------------------------------------------

# Folder that holds your stacks (one subfolder per stack with a compose.yaml).
# Default: /opt/stacks (./stacks on Windows). For local development, point it at
# the repo's git-ignored stacks/ folder.
DOCKET_STACKS_DIR=./stacks

# Folder for the database (users, settings, agents). Default: ./data/
DOCKET_DATA_DIR=./data/

# ---- Server ------------------------------------------------------------------

# Port to listen on. Default: 5001
DOCKET_PORT=5001

# Address to bind to, such as 0.0.0.0 for IPv4 only. Blank: all interfaces
DOCKET_HOSTNAME=

# ---- HTTPS (optional) ----------------------------------------------------------

# Serve over HTTPS with this key and certificate.
DOCKET_SSL_KEY=
DOCKET_SSL_CERT=
DOCKET_SSL_KEY_PASSPHRASE=

# ---- Security ----------------------------------------------------------------

# How long a login lasts before the user must log in again, such as 30m, 12h or
# 7d (a bare number means seconds). Use "never" to keep sessions open.
# Default: 1d
DOCKET_SESSION_EXPIRY=1d

# Allow the host console (a shell on the Docker host) in the UI. Default: false
DOCKET_ENABLE_CONSOLE=false

# ---- Files created by Docket -------------------------------------------------

# When both are set, each stack folder and its compose.yaml are given to this
# user and group whenever the stack is saved.
PUID=
PGID=

# ---- Misc --------------------------------------------------------------------

# Timezone, such as Europe/Paris. Default: the system timezone.
# Keep it commented out unless you set a zone: a blank TZ means UTC in Node.
# TZ=UTC

# Hide log lines, as a comma-separated list of <level>_<module>,
# such as debug_monitor,info_server
DOCKET_HIDE_LOG=

# Log every SQL query (1 to enable)
SQL_LOG=
